# 로컬 전용 예시입니다. 실제 값은 python scripts/init_local_env.py 로 생성합니다.
# 실제 .env 파일은 Git에 넣지 않습니다.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=coffegroup
POSTGRES_USER=coffegroup
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://coffegroup:replace-with-a-random-local-password@127.0.0.1:5432/coffegroup

# 카카오 설정 전에는 False 유지. 실제 값은 채팅이나 저장소에 기록하지 않습니다.
KAKAO_LOGIN_ENABLED=False
KAKAO_RESET_API_KEY=
KAKAO_CLIENT_SECRET=
# 최초 소유자가 카카오 로그인 후 확인한 자기 계정 코드. 지정 후에는 삭제합니다.
INITIAL_OPERATOR_ACCOUNT_CODE=

